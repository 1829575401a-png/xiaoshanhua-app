<!-- pages/login/login.wxml -->
<view class="login-page">
  <view class="login-logo">🗣️</view>
  <view class="login-title">欢迎来到萧山话学堂</view>
  <view class="login-sub">用微信登录，开启你的方言学习之旅</view>

  <!-- 头像显示（开发期用emoji占位） -->
  <view class="avatar-display" bindtap="onTapAvatar">
    <view class="avatar-circle">{{avatarUrl ? '' : '🗣️'}}</view>
    <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
    <text class="avatar-tip">{{avatarUrl ? '已设置头像' : '点击设置头像'}}</text>
  </view>

  <!-- 昵称输入（普通input） -->
  <input
    class="nickname-input"
    type="text"
    placeholder="请输入昵称"
    value="{{nickname}}"
    bindinput="onInputNickname"
    wx:if="{{!loading}}"
  />

  <!-- 登录按钮 -->
  <button
    class="login-btn {{canLogin ? '' : 'disabled'}}"
    bindtap="doLogin"
    disabled="{{loading || !canLogin}}"
    wx:if="{{!loading}}"
  >{{nickname ? '确认登录' : '先完善信息再登录'}}</button>

  <button class="login-btn loading" wx:if="{{loading}}" disabled>登录中...</button>

  <view class="login-tip">登录即代表同意《用户协议》与《隐私政策》</view>
</view>
