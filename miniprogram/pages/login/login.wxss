/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.login-logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 12rpx;
}
.login-sub {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 80rpx;
}

/* 头像按钮 */
.avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  padding: 0 !important;
  background: #F3F4F6 !important;
  margin: 0 auto 32rpx;
  display: flex !important;
  flex-direction: column !important;
  align-items: center;
  justify-content: center;
  border: none !important;
  line-height: normal !important;
}
.avatar-btn::after {
  border: none !important;
}
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-img::before {
  content: '🗣️';
  font-size: 60rpx;
  display: block;
  text-align: center;
  line-height: 120rpx;
}
.avatar-tip {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* 昵称输入 */
.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #374151;
  margin-bottom: 48rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  text-align: center;
}
.nickname-input:focus {
  border-color: #F97316;
  background: #FFF;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #F97316, #EA580C);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 46rpx;
  margin-top: 24rpx;
  border: none;
}
.login-btn.disabled,
.login-btn[disabled] {
  background: #D1D5DB !important;
  color: #9CA3AF !important;
}
.login-btn.loading {
  background: #FBBF24 !important;
}
.login-btn::after {
  border: none;
}

/* 协议提示 */
.login-tip {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 40rpx;
  text-align: center;
}
