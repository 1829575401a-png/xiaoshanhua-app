/* pages/launch/launch.wxss */
.launch-page {
  height: 100vh;
  background: linear-gradient(160deg, #F97316, #EA580C);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.launch-logo {
  font-size: 140rpx;
  margin-bottom: 24rpx;
}
.launch-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}
.launch-slogan {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.launch-feature {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.feat-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
}
.feat-emoji {
  font-size: 44rpx;
}
.feat-text {
  font-size: 30rpx;
  color: #fff;
}

.launch-skip {
  position: absolute;
  bottom: 80rpx;
  right: 48rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}
