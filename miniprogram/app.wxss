/* app.wxss — 全局样式 */
page {
  --primary: #F97316;      /* 萧山话学堂主色：暖橙（方言温度感）*/
  --primary-dark: #EA580C;
  --bg: #F5F5F5;
  --card: #FFFFFF;
  --text: #1F2937;
  --text-light: #6B7280;
  --success: #10B981;
  --warning: #F59E0B;
  --danger: #EF4444;
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view, text, button {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 通用按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.btn-primary[disabled] {
  background: #FCD9B6;
  color: #fff;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 进度条 */
.progress-track {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
