/* components/score-modal/score-modal.wxss */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-card {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.score-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 8rpx solid;
  animation: pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes pop {
  0% { transform: scale(0); }
  100% { transform: scale(1); }
}

.score-num {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
}
.score-emoji {
  font-size: 40rpx;
  margin-top: 8rpx;
}

.score-excellent { border-color: #10B981; color: #10B981; }
.score-good { border-color: #F59E0B; color: #F59E0B; }
.score-poor { border-color: #EF4444; color: #EF4444; }

.score-grade {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.weak-box {
  width: 100%;
  background: #FFF7ED;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.weak-title {
  font-size: 26rpx;
  color: #EA580C;
  font-weight: 600;
}
.weak-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.weak-idx {
  font-size: 24rpx;
  color: #EA580C;
  flex-shrink: 0;
}
.weak-desc {
  font-size: 24rpx;
  color: #6B7280;
  flex: 1;
}
.weak-ok {
  font-size: 26rpx;
  color: #10B981;
}

.btn-retry, .btn-next {
  width: 100%;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.btn-retry {
  background: #F5F5F5;
  color: #374151;
}
.btn-next {
  background: #F97316;
  color: #fff;
}
